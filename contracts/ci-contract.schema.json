{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hemocode-Containment/.github/contracts/ci-contract.schema.json",
  "title": "Hemocode shared CI contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractVersion", "requiredCheck", "runner", "profileCatalog", "billing", "workflows", "callerRequirements"],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schemaVersion": { "const": 1 },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "job", "context"],
      "properties": {
        "workflow": { "const": "CI" },
        "job": { "const": "CI" },
        "context": { "const": "CI / CI" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "profile", "labels", "routingLabel", "legacyRoutingLabels", "imageOs", "provider", "tools"],
      "properties": {
        "group": { "const": "trusted-ci" },
        "profile": { "const": "linux-arm64" },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "allOf": [
            { "contains": { "const": "self-hosted" } },
            { "contains": { "const": "Linux" } },
            { "contains": { "const": "ARM64" } },
            { "contains": { "const": "hemocode-linux-arm64" } },
            { "contains": { "const": "tart-ubuntu24-arm64" } }
          ]
        },
        "routingLabel": { "const": "hemocode-linux-arm64" },
        "legacyRoutingLabels": { "const": ["tart-ubuntu24-arm64"] },
        "imageOs": { "const": "ubuntu24-arm64" },
        "provider": { "const": "provider-neutral" },
        "tools": { "const": ["bash", "docker", "jq", "python3", "shellcheck"] }
      }
    },
    "profileCatalog": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "os", "arch", "routingLabel", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "os": { "enum": ["linux", "windows", "macos"] },
          "arch": { "enum": ["x64", "arm64"] },
          "routingLabel": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "status": { "enum": ["active", "planned"] }
        }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privateCallerRunner", "publicValidatorRunner", "selfHostedUsageFree"],
      "properties": {
        "privateCallerRunner": { "const": "self-hosted" },
        "publicValidatorRunner": { "const": "github-hosted-standard" },
        "selfHostedUsageFree": { "const": true }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elixir", "infrastructure", "linkedIssue"],
      "properties": {
        "elixir": { "const": ".github/workflows/elixir-ci.yml" },
        "infrastructure": { "const": ".github/workflows/infrastructure-ci.yml" },
        "linkedIssue": { "const": ".github/workflows/linked-issue.yml" }
      }
    },
    "callerRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinReusableWorkflowToFullSha", "keepTriggersPermissionsAndConcurrency", "declareSecretsExplicitly", "privateForkWorkflows", "runnerSelectionOwnedBySharedWorkflow"],
      "properties": {
        "pinReusableWorkflowToFullSha": { "const": true },
        "keepTriggersPermissionsAndConcurrency": { "const": true },
        "declareSecretsExplicitly": { "const": true },
        "privateForkWorkflows": { "const": false },
        "runnerSelectionOwnedBySharedWorkflow": { "const": true }
      }
    }
  }
}
